#!/usr/bin/env bash
#SBATCH --job-name=SpeciesTree_ModelFinder
#SBATCH --partition=medium
#SBATCH --nodes=1
#SBATCH --ntasks=4
#SBATCH --mem=16G
#SBATCH --time=08:00:00
#SBATCH --mail-user=rwl2@st-andrews.ac.uk
#SBATCH --mail-type=END,FAIL
#SBATCH --output=SpeciesTree_ModelFinder_9Jun2.out
#SBATCH --error=SpeciesTree_ModelFinder_9Jun2.err

# -------------------------------
# Proper conda initialization
# -------------------------------
# Remove 'module load' (not available on this node)
# and source your real conda path
source /mnt/apps/users/rlouden/conda/etc/profile.d/conda.sh
conda activate iqtree_env

# Debug prints (optional but helpful)
echo "Running on $(hostname)"
echo "Conda environment: $CONDA_DEFAULT_ENV"
which iqtree
iqtree --version

# -------------------------------
# Run IQ-TREE
# -------------------------------
iqtree \
  -s SpeciesTree2.fa \
  -m MFP \
  -bb 1000 \
  -alrt 1000 \
  -nt $SLURM_NTASKS \
  -pre SpeciesTree_Mode_9Jun2
